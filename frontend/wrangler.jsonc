{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frontend",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  // cần khối assets này vì ta deploy lên Worker, Worker giỏi chạy logic, trả về HTML nhưng ko biết các file tĩnh
  // CSS, ảnh,... nên ta cần phải khai báo cho Worker biết là có các file static tại thư mục assets
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}